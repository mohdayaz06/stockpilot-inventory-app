# ==========================================================
# StockPilot Backend - Environment Configuration Template
# Copy this file to ".env" and fill in real values.
# NEVER commit the actual ".env" file to source control.
# ==========================================================

# Server
NODE_ENV=development
PORT=5000

# MongoDB connection string
# Local:   mongodb://127.0.0.1:27017/stockpilot
# Docker:  mongodb://mongo:27017/stockpilot   (service name "mongo" from docker-compose/K8s)
MONGO_URI=mongodb://127.0.0.1:27017/stockpilot

# JWT
JWT_SECRET=change_this_to_a_long_random_secret_string
JWT_EXPIRES_IN=1d

# CORS - comma separated list of allowed origins for the frontend
CORS_ORIGIN=http://localhost:8080

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200
